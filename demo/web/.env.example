# Frontend (Vite) config. Copy to .env for local runs; on Vercel set these in Project > Settings > Environment Variables.

# Engine API origin, no trailing slash. Leave empty locally to use the Vite /v1 proxy.
# Vercel: VITE_API_BASE=https://nitmx-api.onrender.com
VITE_API_BASE=

# Local dev only: where the Vite proxy forwards /v1
API_PROXY_TARGET=http://127.0.0.1:8000
