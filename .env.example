# Backend (FastAPI) config. Copy to .env for local runs; on Render/Railway set these in the dashboard.

# Frontend origins allowed to call the API, comma-separated (no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: regex for extra allowed origins, e.g. Vercel preview deployments
# CORS_ORIGIN_REGEX=https://your-app-.*\.vercel\.app

# Optional: SQLite audit log path (default: artifacts/runtime/audit.sqlite from config/engine.yaml)
# AUDIT_DB=/tmp/audit.sqlite

# Vercel: AUDIT_DB defaults to /tmp/audit.sqlite automatically (VERCEL is set by the platform)
